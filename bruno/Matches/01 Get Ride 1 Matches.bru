meta {
  name: Get Ride 1 Matches
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/rides/{{ride1Id}}/matches
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body) && res.body.length > 0) {
    bru.setEnvVar("matchId", res.body[0].id);
  }
}

tests {
  test("Matches are returned", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}
