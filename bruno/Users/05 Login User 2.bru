meta {
  name: Login User 2
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{user2Email}}",
    "password": "{{user2Password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("user2Token", res.body.accessToken);
  }
}

tests {
  test("User 2 receives a new access token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
  });
}
