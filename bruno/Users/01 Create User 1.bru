meta {
  name: Register User 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Nithin",
    "lastName": "User",
    "email": "{{user1Email}}",
    "phoneNumber": "+1 312-555-0101",
    "password": "{{user1Password}}"
  }
}

script:pre-request {
  const email = `nithin.${Date.now()}@example.com`;
  bru.setVar("user1Email", email);
  bru.setEnvVar("user1Email", email);
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("user1Id", res.body.user.id);
    bru.setEnvVar("user1Token", res.body.accessToken);
  }
}

tests {
  test("User 1 is created", function () {
    expect(res.status).to.equal(201);
    expect(res.body.user.id).to.be.a("string");
    expect(res.body.accessToken).to.be.a("string");
  });
}
