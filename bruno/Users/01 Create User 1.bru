meta {
  name: Create User 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Nithin",
    "lastName": "User",
    "email": "{{user1Email}}",
    "phoneNumber": "+1 312-555-0101"
  }
}

script:pre-request {
  bru.setVar("user1Email", `nithin.${Date.now()}@example.com`);
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("user1Id", res.body.id);
  }
}

tests {
  test("User 1 is created", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}
