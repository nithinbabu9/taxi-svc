meta {
  name: Create User 2
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "{{user2Email}}",
    "phoneNumber": "+1 847-555-0102"
  }
}

script:pre-request {
  bru.setVar("user2Email", `john.${Date.now()}@example.com`);
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("user2Id", res.body.id);
  }
}

tests {
  test("User 2 is created", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}
