# Copy this file to .env for a non-Docker local production-profile run.
# Never commit .env or replace these placeholders in this tracked file.
DATABASE_URL=jdbc:postgresql://localhost:5432/taxi
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-database-password

JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-server-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com
