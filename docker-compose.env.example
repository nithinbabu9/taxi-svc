# Copy this file to .env for local Docker Compose use. Never commit .env.
SPRING_PROFILES_ACTIVE=local

POSTGRES_DB=taxi
POSTGRES_USER=taxi_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433
APP_PORT=8080

JWT_SECRET=local-docker-development-secret-change-me-123456789

# For real Google Maps and SMTP testing, set SPRING_PROFILES_ACTIVE=prod and
# uncomment the values below in your local .env file.
# GOOGLE_MAPS_API_KEY=replace-with-your-server-key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=your-email@gmail.com
